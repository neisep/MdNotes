<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MdNotes.Views.Dialogs.InputDialog"
        Icon="/Assets/mdnotes.ico"
        Width="380" SizeToContent="Height" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MdSurface}">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock x:Name="TitleBlock" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource MdText}" />
        <TextBox x:Name="Input" CornerRadius="6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="OK" IsDefault="True" MinWidth="88" CornerRadius="6" Padding="12,6" Click="OnOk" Classes="primary" />
            <Button Content="Cancel" IsCancel="True" MinWidth="88" CornerRadius="6" Padding="12,6" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
